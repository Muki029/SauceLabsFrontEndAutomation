FROM jenkins/jenkins:lts-jdk17

USER root

# Maven, for running "mvn clean test" in the Jenkinsfile
RUN apt-get update && apt-get install -y maven

# Google Chrome, so the headless Selenium tests have a browser to drive.
# Selenium 4's built-in Selenium Manager downloads a matching chromedriver
# automatically, so we don't need to install that separately.
RUN apt-get install -y wget gnupg \
    && wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER jenkins
